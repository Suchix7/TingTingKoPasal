# MongoDB Atlas connection string
MONGO_URI=

# Cloudinary (Dashboard -> Settings -> API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Express session secret (long random string)
SESSION_SECRET=

# Deployed frontend URL(s) for CORS; comma-separate several (e.g. https://a.vercel.app,https://b.vercel.app)
FRONTEND_URL=

# First password of the "prices" login (customer site with selling prices).
# Used once, while it has none; change it later with scripts/set-price-password.mjs
PRICE_PASSWORD=

PORT=5000
NODE_ENV=production
